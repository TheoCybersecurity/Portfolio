# Copier ce fichier en .env et renseigner les valeurs. Le fichier .env n'est jamais versionné.

# IP autorisées à ouvrir le panel /admin : adresses exactes ou plages CIDR, séparées par des virgules.
ADMIN_IPS=203.0.113.10,2001:db8:1234:5678::/64

# Envoi des messages du formulaire de contact (laisser vide pour désactiver l'envoi).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Portfolio <contact@example.com>
SMTP_TO=contact@example.com
